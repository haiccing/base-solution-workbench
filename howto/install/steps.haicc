# step: the workbench: deployed, commissioned: its components, then itself in service
. boot/deploy workbench haiccing/base-solution-workbench
# expect: "deployed":"workbench"
# step: what the workbench deployed: its links, docs and splectral
workbench crud/read "*"
# expect: "uri":["main","docs"]
# expect: "uri":["main","splectral"]
# step: Splectral in service: its server's address; its help view at /help/, the docs mrepo's pages
workbench/splectral splectral/status
# expect: "url":"http://127.0.0.1:
# step: where the docs mrepo is, from the registry
. haicc/mrepos local/docs
# expect: "uri":"local/docs","position":"workbench/docs"
# step: the documentation
workbench/docs info/get
# expect: "keyword":"."
# step: the howtos namespace, in the workbench
workbench crud/read howtos
# expect: "kind":"howtos"
# step: torn down: its decommission first, its components with it
. boot/teardown workbench
# expect: "tornDown":"workbench"
. haicc/mrepos local/docs
# expect: []
